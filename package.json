{
  "name": "@elonehoo/is-window",
  "version": "0.0.5",
  "description": "Check if the given value is a window object.",
  "license": "MIT",
  "author": "Elone Hoo <huchengyea@163.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elonehoo/is-window"
  },
  "homepage": "https://github.com/elonehoo/is-window#readme",
  "bugs": "https://github.com/elonehoo/is-window/issues",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    },
    "./*": "./*"
  },
  "files": [
    "dist",
    "*.d.ts"
  ],
  "scripts": {
    "build": "rimraf dist && unbuild",
    "release": "bumpp package.json --commit --push --tag && pnpm -r publish --access public",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@elonehoo/eslint-config": "2.0.0",
    "@elonehoo/rimraf": "^0.0.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "bumpp": "12.3.0",
    "c8": "^12.0.0",
    "eslint": "10.13.0",
    "pnpm": "12.15.0",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.72.0",
    "unbuild": "^3.6.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
